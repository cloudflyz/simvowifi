# simvowifi compose 环境变量（复制为 .env 后按需修改）

# 数据目录（config.yaml / instance.json / certs / logs / run 都在这里）
SIMVOWIFI_DATA_DIR=./data

# WebUI 端口（默认 8081，避开常见占用）
WEBUI_PORT=8081

# 时区
TZ=Asia/Shanghai

# 镜像：默认从 GitHub Container Registry 拉取（公开后无需登录）
# 本地构建时改成 simvowifi/engine:latest / simvowifi/webui:latest，
# 并配合 docker-compose.build.yml 使用。
SIMVOWIFI_ENGINE_IMAGE=ghcr.io/cloudflyz/simvowifi-engine:latest
SIMVOWIFI_WEBUI_IMAGE=ghcr.io/cloudflyz/simvowifi-webui:latest
